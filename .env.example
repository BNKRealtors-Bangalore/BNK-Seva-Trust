PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/donations.sqlite

# Use live Razorpay credentials only after the Trust account is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional SMTP settings for emailing the verified receipt.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BNK Seva Trust <receipts@example.org>

# Add only after the Trust confirms the exact applicable receipt wording.
RECEIPT_POLICY_NOTE=This receipt acknowledges the donation received. Any statutory or tax-exemption certificate is issued only where applicable under Trust policy and law.