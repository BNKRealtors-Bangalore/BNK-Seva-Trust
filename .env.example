PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/donations.sqlite

# Use live Razorpay credentials only after the Trust account is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional SMTP settings for emailing the verified receipt.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Bnksevatrust@gmail.com
SMTP_PASS=
SMTP_FROM=BNK Seva Trust <Bnksevatrust@gmail.com>

# Add only after the Trust confirms the exact applicable receipt wording.
RECEIPT_POLICY_NOTE=This receipt acknowledges the donation received. Any statutory or tax-exemption certificate is issued only where applicable under Trust policy and law.
# Initial admin account (existing passwords are preserved).
ADMIN_EMAIL=Bnksevatrust@gmail.com
ADMIN_NAME=BNK Admin
ADMIN_PASSWORD=

# Required persistent database for Vercel (create a Turso database).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: connect a public Vercel Blob store for admin image uploads.
BLOB_READ_WRITE_TOKEN=

# Automatically configured when connecting Blob with Vercel OIDC.
BLOB_STORE_ID=


PUBLIC_SITE_URL=https://bnksevatrust.vercel.app

# Required to authorize the scheduled maintenance worker (use a random secret).
CRON_SECRET=
# AES-256 backup key: generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a separate secure copy: losing this key makes encrypted backups unrecoverable.
BACKUP_ENCRYPTION_KEY=
# A SEPARATE PRIVATE Blob store; never use the public image store for backups.
BACKUP_BLOB_STORE_ID=
BACKUP_BLOB_READ_WRITE_TOKEN=
